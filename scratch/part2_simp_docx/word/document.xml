<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:sl="http://schemas.openxmlformats.org/schemaLibrary/2006/main" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture" xmlns:c="http://schemas.openxmlformats.org/drawingml/2006/chart" xmlns:lc="http://schemas.openxmlformats.org/drawingml/2006/lockedCanvas" xmlns:dgm="http://schemas.openxmlformats.org/drawingml/2006/diagram" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns="http://schemas.microsoft.com/office/tasks/2019/documenttasks" xmlns:cr="http://schemas.microsoft.com/office/comments/2020/reactions"><w:background w:color="F6B26B"/><w:body><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000001"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_ihagoes26l26" w:id="0"/><w:bookmarkEnd w:id="0"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 5 का सार / Summary of Article 5</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000002"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">Article 5 states that at the start of the Constitution on January 26, 1950, every person who had their permanent home (domicile) in India and met any one of the three conditions would be an Indian citizen. These conditions are being born in India, having either parent born in India, or having resided ordinarily in India for at least five years immediately before the Constitution began. </w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000003"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 5 यह व्यवस्था करता है कि संविधान के लागू होने के समय (26 जनवरी 1950) प्रत्येक व्यक्ति जिसका भारत में अपना स्थाई घर (अधिवास) था, वह भारत का नागरिक होगा यदि वह तीन में से कोई एक शर्त पूरी करता हो। ये शर्तें हैं कि उसका जन्म भारत में हुआ हो, उसके माता-पिता में से कोई भारत में पैदा हुआ हो, या वह संविधान लागू होने से ठीक पहले कम से कम पांच वर्षों से सामान्य रूप से भारत में रह रहा हो।</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000004"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:ind w:left="0" w:right="600" w:firstLine="0"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000005"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:ind w:left="0" w:right="600" w:firstLine="0"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:pict><v:rect style="width:0.0pt;height:1.5pt" o:hr="t" o:hrstd="t" o:hralign="center" fillcolor="#A0A0A0" stroked="f"/></w:pict></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000006"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:ind w:left="0" w:right="600" w:firstLine="0"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000007"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_adi19alwo2ha" w:id="1"/><w:bookmarkEnd w:id="1"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 6 का सार / Summary of Article 6</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000008"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">Article 6 deals with the citizenship of individuals who moved from Pakistan to India. Such a person is deemed a citizen if they or their ancestors were born in undivided India under the 1935 Act and they migrated before July 19, 1948, while remaining an ordinary resident. If they migrated on or after July 19, 1948, they must have registered themselves as a citizen by applying to a designated government officer before the Constitution started, after having lived in India for at least six months before the application. </w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000009"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 6 पाकिस्तान से भारत आने वाले लोगों के नागरिकता अधिकारों को तय करता है। इसके अनुसार, यदि कोई व्यक्ति या उसके पूर्वज अविभाजित भारत में पैदा हुए थे, तो वह भारत का नागरिक माना जाएगा यदि वह 19 जुलाई 1948 से पहले भारत आकर सामान्य रूप से रहने लगा हो। यदि वह व्यक्ति 19 जुलाई 1948 को या उसके बाद आया है, तो उसे संविधान लागू होने से पहले नियुक्त अधिकारी को आवेदन देकर नागरिक के रूप में पंजीकृत होना होगा, जिसके लिए आवेदन से ठीक पहले न्यूनतम छह महीने भारत में रहना अनिवार्य है।</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000A"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_iqp619s62t9x" w:id="2"/><w:bookmarkEnd w:id="2"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000B"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_tiyzu79sjte3" w:id="3"/><w:bookmarkEnd w:id="3"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:pict><v:rect style="width:0.0pt;height:1.5pt" o:hr="t" o:hrstd="t" o:hralign="center" fillcolor="#A0A0A0" stroked="f"/></w:pict></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000C"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_pt806xvldaj5" w:id="4"/><w:bookmarkEnd w:id="4"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 7 का सार / Summary of Article 7</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000D"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">Article 7 states that any person who left India for Pakistan after March 1, 1947, will not be considered an Indian citizen. However, this rule does not apply to a person who returns to India under a legal permit for resettlement or permanent return. Such a returning person will be treated as if they migrated to India after July 19, 1948, and can seek registration accordingly. </w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000E"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 7 यह घोषित करता है कि जो व्यक्ति 1 मार्च 1947 के बाद भारत छोड़कर पाकिस्तान चला गया था, उसे भारत का नागरिक नहीं माना जाएगा। लेकिन, यदि वह व्यक्ति पुनर्वास या स्थाई रूप से भारत लौटने की कानूनी अनुमति (परमिट) के तहत वापस भारत आता है, तो उस पर यह रोक लागू नहीं होगी और उसे 19 जुलाई 1948 के बाद भारत आने वाले लोगों की तरह नागरिकता प्राप्त करने का हक होगा।</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000F"><w:pPr><w:pStyle w:val="Heading3"/><w:spacing w:after="80" w:before="280" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_1a7ds0943ml6" w:id="5"/><w:bookmarkEnd w:id="5"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000010"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_pga24di8odlx" w:id="6"/><w:bookmarkEnd w:id="6"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 8 का सार / Summary of Article 8</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000011"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">Article 8 allows persons of Indian origin living in foreign countries to obtain citizenship. If a person, or either of their parents or grandparents, was born in undivided India as per the 1935 Act, and they are living in another country, they will be considered an Indian citizen if they register themselves with the Indian diplomatic or consular representative in that country by applying in the prescribed format. </w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000012"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 8 विदेश में रहने वाले भारतीय मूल के लोगों को नागरिकता प्रदान करने की व्यवस्था करता है। यदि कोई व्यक्ति, या उसके माता-पिता या दादा-दादी में से कोई 1935 के अधिनियम के तहत परिभाषित अविभाजित भारत में पैदा हुए थे और वह व्यक्ति विदेशों में रह रहा है, तो वह भारतीय राजनयिक या वाणिज्य प्रतिनिधि के पास निर्धारित प्ररूप में पंजीकरण के लिए आवेदन करके भारत का नागरिक बन सकता है।</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000013"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:ind w:left="600" w:right="600" w:firstLine="0"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:pict><v:rect style="width:0.0pt;height:1.5pt" o:hr="t" o:hrstd="t" o:hralign="center" fillcolor="#A0A0A0" stroked="f"/></w:pict></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000014"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_g6vc9h3jzk6o" w:id="7"/><w:bookmarkEnd w:id="7"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 9 का सार / Summary of Article 9</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000015"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">Article 9 declares that any individual who has of their own free will acquired the citizenship of a foreign country cannot claim or hold Indian citizenship under Article 5, 6, or 8. </w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000016"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 9 यह स्पष्ट करता है कि यदि किसी व्यक्ति ने स्वेच्छा से किसी विदेशी देश की नागरिकता प्राप्त कर ली है, तो वह अनुच्छेद 5, 6 या 8 में से किसी भी प्रावधान के तहत भारत का नागरिक नहीं रहेगा और उसकी भारतीय नागरिकता समाप्त हो जाएगी।</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000017"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:ind w:left="600" w:right="600" w:firstLine="0"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000018"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:ind w:left="600" w:right="600" w:firstLine="0"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:pict><v:rect style="width:0.0pt;height:1.5pt" o:hr="t" o:hrstd="t" o:hralign="center" fillcolor="#A0A0A0" stroked="f"/></w:pict></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000019"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_fcb4897nv4ex" w:id="8"/><w:bookmarkEnd w:id="8"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 10 का सार / Summary of Article 10</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000001A"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">Article 10 provides a guarantee that any person who is a citizen of India under the preceding rules will continue to remain a citizen, subject only to any laws that may be passed by Parliament. </w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000001B"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 10 यह सुरक्षा देता है कि जो भी व्यक्ति इस भाग के पिछले प्रावधानों के तहत भारत का नागरिक है या समझा जाता है, वह आगे भी भारत का नागरिक बना रहेगा, बशर्ते कि संसद इस विषय पर कोई नया कानून न बनाए।</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000001C"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:ind w:left="600" w:right="600" w:firstLine="0"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:pict><v:rect style="width:0.0pt;height:1.5pt" o:hr="t" o:hrstd="t" o:hralign="center" fillcolor="#A0A0A0" stroked="f"/></w:pict></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000001D"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_oy2al5h83ct4" w:id="9"/><w:bookmarkEnd w:id="9"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 11 का सार / Summary of Article 11</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000001E"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:b w:val="1"/><w:bCs w:val="1"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">Article 11 confirms that none of the provisions regarding citizenship listed in Part II will restrict the supreme power of Parliament to make laws concerning the acquisition, loss, or any other matters related to citizenship. </w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000001F"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 11 यह घोषित करता है कि भाग II के पिछले अनुच्छेदों में दी गई कोई भी बात नागरिकता प्राप्त करने, उसे खोने या नागरिकता से जुड़े किसी भी अन्य मामले में नियम बनाने की संसद की सर्वोच्च शक्ति को प्रभावित या कम नहीं करेगी।</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000020"><w:pPr><w:pBdr><w:top w:space="0" w:sz="0" w:val="nil"/><w:left w:space="0" w:sz="0" w:val="nil"/><w:bottom w:space="0" w:sz="0" w:val="nil"/><w:right 