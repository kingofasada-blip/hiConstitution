><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:b w:val="1"/><w:bCs w:val="1"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000004"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 1 हमारे देश के नाम को इंडिया, अर्थात् भारत के रूप में घोषित करता है और इसकी राजनीतिक संरचना को राज्यों के संघ के रूप में परिभाषित करता है। यह स्पष्ट करता है कि भारत के राज्यक्षेत्र में मुख्य रूप से तीन हिस्से शामिल होंगे जिसमें राज्यों के अपने राज्यक्षेत्र, पहली अनुसूची में दिए गए केंद्र शासित प्रदेश यानी संघ राज्यक्षेत्र और ऐसे अन्य क्षेत्र शामिल हैं जिन्हें भविष्य में भारत द्वारा अधिग्रहित या अर्जित किया जा सकता है।</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000005"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_38v7i2l7styo" w:id="1"/><w:bookmarkEnd w:id="1"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:pict><v:rect style="width:0.0pt;height:1.5pt" o:hr="t" o:hrstd="t" o:hralign="center" fillcolor="#A0A0A0" stroked="f"/></w:pict></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000006"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_xgxxz4ntss5m" w:id="2"/><w:bookmarkEnd w:id="2"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000007"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:b w:val="1"/><w:bCs w:val="1"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_pdd82agdgm8u" w:id="3"/><w:bookmarkEnd w:id="3"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 2 का सार / Summary of Article 2</w:t></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000008"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">Article 2 empowers the Parliament to pass laws to admit existing states into the Union or to establish completely new states from external territories. This legislative action can be carried out under any terms and conditions that the Parliament deems appropriate. </w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000009"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:b w:val="1"/><w:bCs w:val="1"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000A"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 2 संसद को कानून बनाकर संघ में नए राज्यों को प्रवेश देने या नए राज्यों की स्थापना करने का अंतिम अधिकार देता है। संसद इस प्रवेश या स्थापना के लिए अपनी सुविधानुसार उन नियमों और शर्तों को निर्धारित कर सकती है जिन्हें वह सही और उचित समझे।</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000B"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_gzrtg76nd6wm" w:id="4"/><w:bookmarkEnd w:id="4"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:pict><v:rect style="width:0.0pt;height:1.5pt" o:hr="t" o:hrstd="t" o:hralign="center" fillcolor="#A0A0A0" stroked="f"/></w:pict></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000C"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_8jgr93j8v2ko" w:id="5"/><w:bookmarkEnd w:id="5"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 2क का सार / Summary of Article 2A</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000D"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">Article 2A, which was previously enacted to associate the territory of Sikkim with the Union of India, has been completely omitted from the Constitution and is no longer in force. </w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000E"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 2क, जो पूर्व में सिक्किम को भारतीय संघ के साथ एक सहयोगी राज्य के रूप में जोड़ने का प्रावधान करता था, उसे संविधान संशोधन द्वारा पूरी तरह से हटा दिया गया है और अब इसका कोई अस्तित्व नहीं है।</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="0000000F"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_mv1e2senaidl" w:id="6"/><w:bookmarkEnd w:id="6"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:pict><v:rect style="width:0.0pt;height:1.5pt" o:hr="t" o:hrstd="t" o:hralign="center" fillcolor="#A0A0A0" stroked="f"/></w:pict></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000010"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_rrvidsduz17" w:id="7"/><w:bookmarkEnd w:id="7"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 3 का सार / Summary of Article 3</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000011"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">Article 3 gives Parliament the authority to create new states by separating territory from an existing state, combining states, or merging any territory with a part of a state. It also allows Parliament to increase or decrease the area of any state, change its boundaries, or alter its name. Such a bill can only be introduced on the President's recommendation, and if it affects a state, the President must first refer it to that state's legislature to express its views within a specified time limit. It clarifies that while &quot;State&quot; generally includes Union Territories in the main body, it does not do so in the proviso requiring consultation. </w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000012"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 3 संसद को यह शक्ति देता है कि वह किसी राज्य के हिस्से को अलग करके, दो या अधिक राज्यों को मिलाकर, या किसी क्षेत्र को किसी राज्य से जोड़कर नए राज्य का निर्माण कर सके। इसके साथ ही संसद किसी राज्य का क्षेत्रफल बढ़ा या घटा सकती है, उसकी सीमाओं में और उसके नाम में बदलाव कर सकती है। इसके लिए राष्ट्रपति की पूर्व सिफारिश आवश्यक है, और यदि यह प्रस्ताव किसी राज्य को प्रभावित करता है तो राष्ट्रपति को इसे संबंधित राज्य के विधानमंडल के पास निर्धारित समय में विचार प्रकट करने के लिए भेजना होगा। स्पष्टीकरण के अनुसार मुख्य अनुच्छेद में 'राज्य' शब्द के अंतर्गत केंद्र शासित प्रदेश भी आते हैं परंतु विधानसभा परामर्श वाले नियम में केंद्र शासित प्रदेश शामिल नहीं हैं।</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000013"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_5ayvdssotgaf" w:id="8"/><w:bookmarkEnd w:id="8"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:pict><v:rect style="width:0.0pt;height:1.5pt" o:hr="t" o:hrstd="t" o:hralign="center" fillcolor="#A0A0A0" stroked="f"/></w:pict></w:r><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000014"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_n2luss991s2p" w:id="9"/><w:bookmarkEnd w:id="9"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000015"><w:pPr><w:pStyle w:val="Heading4"/><w:spacing w:after="40" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/></w:rPr></w:pPr><w:bookmarkStart w:colFirst="0" w:colLast="0" w:name="_o5s216c28x01" w:id="10"/><w:bookmarkEnd w:id="10"/><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 4 का सार / Summary of Article 4</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000016"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">Article 4 mandates that any law made under Article 2 or Article 3 must include the necessary amendments for the First Schedule and the Fourth Schedule of the Constitution to make the territorial changes functional. It also allows Parliament to make additional supplemental, incidental, or representation-related provisions. Crucially, it declares that no such law will be considered a formal constitutional amendment under Article 368. </w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000017"><w:pPr><w:spacing w:after="240" w:before="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl w:val="0"/></w:rPr><w:t xml:space="preserve">अनुच्छेद 4 यह आवश्यक बनाता है कि अनुच्छेद 2 या अनुच्छेद 3 के तहत बनाए गए किसी भी कानून में पहली अनुसूची और चौथी अनुसूची में आवश्यक बदलाव करने के निर्देश शामिल होंगे ताकि किए गए परिवर्तनों को प्रभावी बनाया जा सके। इसके साथ ही संसद अन्य पूरक, आनुषंगिक या विधायिकाओं में प्रतिनिधित्व से संबंधित आवश्यक बदलाव भी कर सकती है। यह स्पष्ट करता है कि ऐसे किसी भी कानून को अनुच्छेद 368 के तहत संविधान का औपचारिक संशोधन नहीं माना जाएगा।</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidDel="00000000" w:rsidP="00000000" w:rsidRDefault="00000000" w:rsidRPr="00000000" w14:paraId="00000018"><w:pPr><w:pBdr><w:top w:space="0" w:sz="0" w:val="nil"/><w:left w:space="0" w:sz="0" w:val="nil"/><w:bottom w:space="0" w:sz="0" w:val="nil"/><w:right w:space="0" w:sz="0" w:val="nil"/><w:between w:space="0" w:sz="0" w:val="nil"/></w:pBdr><w:shd w:fill="auto" w:val="clear"/><w:spacing w:after="240" w:line="275.9999942779541" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Eczar" w:cs="Eczar" w:eastAsia="Eczar" w:hAnsi="Eczar"/><w:color w:val="1f1f1f"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidDel="00000000" w:rsidR="00000000" w:rsidRPr="00000000"><w:rPr><w:rtl w:val="0"/></w:rPr></w:r></w:p><w:sectPr><w:pgSz w:h="15840" w:w="12240" w:orient="portrait"/><w:pgMar w:bottom="1440" w:top="1440" w:left="1440" w:right="1440" w:header="0" w:footer="720"/><w:pgNumType w:start="1"/></w:sectPr></w:body></w:document>